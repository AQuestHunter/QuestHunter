# Supabase: Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Optional: default campaign slug (quests.campaign_slug). Omit for legacy “newest playable quest anywhere”.
# When several projects are live, players can switch on the Quests page (stored per device); this env still sets the initial default if unset.
# VITE_QUEST_CAMPAIGN_SLUG=project-oracle

# Web Push (PWA): VAPID public key only in the browser. Generate with: npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY=
